close all
clear all
clc

its = 1;
itsmax = 10;
t = tcpclient("127.0.0.1",10002);
while its < itsmax

%% READ FROM DEEPTHOUGHT

    disp(its)
    % steve = read(t,t.NumBytesAvailable,"char");
    % 
    % disp(steve)

    if its > 1
        readline(t); %' '
        readline(t); % [EOF]
    end
    datestr = readline(t);
    readline(t); % ParmLoadEnabled
    readline(t); % ParmDumpEnabled
    dtstr = readline(t);
    timestr = readline(t);
    angvelstrtrue = readline(t);
    attstrtrue = readline(t);
    sunpntstr_in = readline(t);
    % Gyro
    gyro1str = readline(t);
    gyro2str = readline(t);
    gyro3str = readline(t);
    % Star tracker
    stvalidstr(its) = readline(t); % valid
    st_str = readline(t);
    % GPS
    for i = 1:14
        if i == 5
            GPSposstr = readline(t);
        else
            readline(t);
        end
    end

    % Accelerometers
    acc1str = readline(t);
    acc2str = readline(t);
    acc3str = readline(t);

    % Reaction wheels
    whl1str = readline(t);
    whl2str = readline(t);
    whl3str = readline(t);

    readline(t) % [EOF] 
    
    write(t,"Read!","uint8")
    
%% - COMMANDS

    l1 = 'SC[0].AC.Whl[0].Tcmd = 0.0001';
    l2 = 'SC[0].AC.Whl[1].Tcmd = 0.0001';
    l3 = 'SC[0].AC.Whl[2].Tcmd = 0.0001';
    
    B = double('SC[0].AC.Whl[0].Tcmd = 0.014');
    disp(B())
    write(t,cast(append(B,"10"),"uint8"),"uint8")

    its = its + 1;
    b = 1;
    disp('-----------------------------')
end